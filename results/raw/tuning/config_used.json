{
  "env": {
    "id": "FrozenLake-v1",
    "map_name": "8x8",
    "is_slippery": true
  },
  "gamma": 0.99,
  "fixed_point": {
    "v_min": 0.0,
    "v_max": 1.0
  },
  "train": {
    "budget_steps": 1000000,
    "eps_start": 1.0,
    "eps_end": 0.05
  },
  "eval": {
    "every_steps": 25000,
    "rollouts": 100,
    "final_rollouts": 1000,
    "seed_base": 10000000
  },
  "hyperparameters": {
    "qlearning": {
      "alpha": 0.1,
      "eps_decay_fraction": 0.6
    },
    "sarsa": {
      "alpha": 0.1,
      "eps_decay_fraction": 0.6
    }
  },
  "name": "tuning",
  "algorithms": [
    "qlearning",
    "sarsa"
  ],
  "precisions": [
    "fp32"
  ],
  "roundings": [],
  "seeds": {
    "start": 1000,
    "count": 5
  },
  "tune_grid": {
    "alpha": [
      0.05,
      0.1,
      0.2,
      0.3
    ],
    "eps_decay_fraction": [
      0.4,
      0.6,
      0.8
    ]
  }
}